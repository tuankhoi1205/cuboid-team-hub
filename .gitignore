# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store
/self-host/dist/
/self-host/.runtime/
/self-host/node_modules/
/self-host/data/
**/__pycache__/
/qc-desktop/node_modules/
/qc-desktop/dist/
/qc-desktop/worker/
/qc-desktop/release/
/qc-desktop/.build/

# Live databases and decryption keys stay local. Only encrypted snapshots enter Git.
**/repo-backup-key*.json
/data/*.tmp
